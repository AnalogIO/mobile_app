{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug mode (development flavor)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main.dart"
      ]
    },
    // `localhost` is the device itself. This config is for the iOS simulator
    // (or an Android emulator after `adb reverse tcp:8080 tcp:8080`).
    {
      "name": "Debug mode (local backend)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main.dart",
        "--dart-define=API_BASE_URL=http://localhost:8080"
      ]
    },
    // The Android emulator reaches the host machine (and the local backend)
    // through 10.0.2.2, so it cannot use the `localhost` config above.
    {
      "name": "Debug mode (local backend, Android emulator)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main.dart",
        "--dart-define=API_BASE_URL=http://10.0.2.2:8080"
      ]
    },
    {
      "name": "Release mode (development flavor)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--release",
        "--flavor",
        "development",
        "--target",
        "lib/main.dart"
      ]
    }
  ]
}
